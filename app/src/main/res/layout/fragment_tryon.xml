<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera preview fills the screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay drawn on top of the camera preview (skeleton + garment) -->
    <com.fyp.virtualtryon.ui.tryon.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/camera_preview"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview" />

    <!-- Camera flip button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_flip_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Flip camera"
        app:srcCompat="@drawable/ic_flip_camera"
        app:backgroundTint="#99000000"
        app:tint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Head-pose warning banner (shown when user is not looking straight) -->
    <TextView
        android:id="@+id/tv_head_pose_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center"
        android:text="Keep a straight face"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fit warning banner (initially hidden) -->
    <TextView
        android:id="@+id/tv_fit_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Horizontal strip of garment thumbnails for the active category -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_garment_thumbs"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="#66000000"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@id/chip_group_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category chip group -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:singleSelection="true"
        app:layout_constraintBottom_toTopOf="@id/tv_selected_garment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_shirts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_shirts"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_pants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_pants"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_glasses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_glasses"
            style="@style/Widget.Material3.Chip.Filter" />
        -->

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_glasses_v2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glasses"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_shoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shoes"
            android:enabled="false"
            style="@style/Widget.Material3.Chip.Filter" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Selected garment name -->
    <TextView
        android:id="@+id/tv_selected_garment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:text="@string/no_garment_selected"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:background="#99000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
